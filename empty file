#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for(int i = 0; i < n; i++){
        scanf("%d", &arr[i]);
    }

    int fre[100001] = {0};   // frequency array

    for(int i = 0; i < n; i++){
        fre[arr[i]]++;
    }

    // Print only elements that appear
    for(int i = 0; i < 100001; i++){
        if(fre[i] > 0){
            printf("%d appears %d times\n", i, fre[i]);
        }
    }

    return 0;
}

